;; kotoba-lang/kisekae — VRM character editor domain library (ADR-2607071610).
;; The editor LAYER over kotoba-lang/org-vrmc-vrm's existing engine (parse/
;; decompose/compose/export): character-spec EDN document, pure edit ops +
;; undo/redo, spec -> .vrm build, kotobase-shaped persistence contract.
;; Pure .cljc, one dependency, no UI here — the consuming app supplies
;; viewport (canvaskit), preview render (kami-webgpu), and controls
;; (kotoba-lang/editor's walk-and-surface).
{:paths ["src"]

 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; The engine: VRM parse/decompose/compose/export, zero-dep .cljc.
        ;; Sibling-path convention, same as every kotoba-lang consumer.
        ;; io.github.* is the coordinate kami-gen-ml3d, kami-gen-hybrid,
        ;; kami-gen-procedural and kami-app-character-creator name this repository by.
        ;; Exporting the bare group from here put org-vrmc-vrm on their classpaths
        ;; twice -- measured in kami-gen-ml3d, which reaches this repo through
        ;; cloud-murakumo and also declares the io.github.* coordinate itself.
        io.github.kotoba-lang/org-vrmc-vrm {:git/url "https://github.com/kotoba-lang/org-vrmc-vrm.git"
                                     :git/sha "8d8725af2feb4666cfd9573a30cc879b5fd43878"}
        kotoba-lang/kotoba-lang {:git/url "https://github.com/kotoba-lang/kotoba-lang.git"
                                     :git/sha "58953074c9206938bcf9fc81f7d44feee7b0db44"}}

 :aliases
 {:lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}